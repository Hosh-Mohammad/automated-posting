# Copy to .env and fill in the platforms you want to use.
# Platforms with missing credentials are reported as "failed" for that platform
# only; the others still post.

# --- Telegraph (https://telegra.ph) -------------------------------------
# Optional: leave empty and an anonymous account is created automatically.
TELEGRAPH_ACCESS_TOKEN=

# --- Bluesky -------------------------------------------------------------
# Settings > Privacy and security > App passwords
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_IDENTIFIER=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# --- Mastodon ------------------------------------------------------------
# Preferences > Development > New application (scope: write:statuses)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Telegram ------------------------------------------------------------
# Create a bot with @BotFather, add it as admin of a PUBLIC channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@your_public_channel

# --- Discord -------------------------------------------------------------
# Channel settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# --- DEV Community -------------------------------------------------------
# Settings > Extensions > DEV Community API Keys
DEVTO_API_KEY=

# --- Tuning (optional) ---------------------------------------------------
# REQUEST_TIMEOUT=20
# PLATFORM_DEADLINE=45
